APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Legal pages -------------------------------------------------------------
# Shown on /privacy and /terms. Google and Microsoft read these URLs during
# OAuth app verification and check that the entity named matches the owner of
# the OAuth client and the verified domain, so real values are required.
LEGAL_ENTITY_NAME=
LEGAL_PRODUCT_NAME="Cadence"
LEGAL_ADDRESS=
LEGAL_PRIVACY_EMAIL=
LEGAL_SUPPORT_EMAIL=
LEGAL_JURISDICTION=
LEGAL_EFFECTIVE_DATE=

# --- Google (Gmail + Calendar) -----------------------------------------------
# OAuth 2.0 client credentials, not an API key: Google rejects API keys for
# private user data. Create a Web application client in Google Cloud Console and
# add the redirect URI below to its authorised list, character for character.
# Mail sync is opt-in. Left off, the Gmail scopes are never requested, which
# keeps app verification to ordinary review — the Gmail scopes are Google's
# "restricted" tier and require an annual third-party security assessment.
# Calendar sync works either way. Turning this on requires reconnecting.
GOOGLE_SYNC_INBOX=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/integrations/gmail/callback"

# Push notifications. Optional — without them calendar sync falls back to the
# scheduled poll, which costs latency but nothing else. Google will only accept
# the watch request once this domain is verified in Search Console and added to
# the Cloud project.
GOOGLE_CALENDAR_PUSH_ENABLED=false
GOOGLE_CALENDAR_WEBHOOK_URL="${APP_URL}/integrations/google-calendar/webhook"
GOOGLE_PUBSUB_TOPIC=

# --- Microsoft 365 (Mail + Calendar) -----------------------------------------
MS_SYNC_INBOX=false
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI="${APP_URL}/integrations/microsoft/callback"
MS_WEBHOOK_URL="${APP_URL}/integrations/microsoft/webhook"
